APP_NAME=ShopeeManager
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://mystores.melur.com
FRONTEND_URL=https://mystores.melur.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=melurcom_mystoresdb
DB_USERNAME=melurcom_mystores_user
DB_PASSWORD=replace-with-production-database-password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SANCTUM_NEW_TOKEN_EXPIRATION=43200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

SHOPEE_PARTNER_ID=replace-with-shopee-partner-id
SHOPEE_PARTNER_KEY=replace-with-shopee-partner-key
# Live Push Partner Key from Shopee Push settings (webhook signature verification).
SHOPEE_PUSH_PARTNER_KEY=replace-with-shopee-push-partner-key
SHOPEE_REDIRECT_URL=https://mystores.melur.com/api/shopee/callback
# Must exactly match the Push callback URL registered in the live Shopee app (used for signature verification).
SHOPEE_WEBHOOK_URL=https://mystores.melur.com/api/shopee/webhook
SHOPEE_SANDBOX=false
