APP_NAME=ShopeeManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_NEW_TOKEN_EXPIRATION=43200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shopee Open Platform
# Local (sandbox / MelurShopeeAPILocal): use Test Partner_id for that app.
# Production (MelurCom): set in deploy/.env.production only — never overwrite with local values.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Optional: Push Partner Key from Shopee Push settings (preferred for webhook signature verify).
# SHOPEE_PUSH_PARTNER_KEY=
SHOPEE_REDIRECT_URL=http://localhost:8000/api/shopee/callback
# Exact public URL registered in Shopee Push Console (must match signature base URL).
SHOPEE_WEBHOOK_URL=
SHOPEE_SANDBOX=true

# Lazada Open Platform (required for Lazada store link / stock writes)
# Production: set in deploy/.env.production only.
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_REDIRECT_URL=https://mystores.melur.com/api/lazada/callback
LAZADA_SANDBOX=false

# Google reCAPTCHA v2
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=6Le7N2ktAAAAAKm2nKq4vgTfZ2_CqQu8c8-XJZi2
RECAPTCHA_SECRET_KEY=6Le7N2ktAAAAAPrJiepRvqmEMX8aIqx2mWE6DMxs

# POS Melur ERP API (pos.melur.com)
# Ultimate POS Connector API — used for POS Inventory screen.
# Pushing to Lazada/Shopee remains manual. Auto-sync only pulls from ERP.
ERP_API_BASE_URL=https://pos.melur.com
ERP_API_CLIENT_ID=
ERP_API_CLIENT_SECRET=
ERP_API_USERNAME=
ERP_API_PASSWORD=
ERP_AUTO_SYNC_ENABLED=false
# Business Location ID for Melur Tumpat / Nurseri Tumpat location
ERP_LOCATION_ID=10

