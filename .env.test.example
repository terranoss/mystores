# E2E Test Environment Variables
# Copy this file to .env.test and fill in your credentials.
# NEVER commit .env.test to git.

# Base URL of the application (defaults to localhost:5173)
TEST_BASE_URL=https://mystores.melur.com

# Test user credentials — use a dedicated test account, not a production admin
TEST_USER_EMAIL=your-test-user@example.com
TEST_USER_PASSWORD=your-test-password
